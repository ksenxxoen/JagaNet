        <mxCell id="e5" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#7d889b;fontColor=#5a6476;" edge="1" parent="1" source="cdn" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;startArrow=block;endArrow=block;strokeColor=#7d889b;" edge="1" parent="1" source="worker" target="tgapi"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;startArrow=block;endArrow=block;strokeColor=#7d889b;" edge="1" parent="1" source="api" target="pg"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;startArrow=block;endArrow=block;strokeColor=#7d889b;" edge="1" parent="1" source="worker" target="pg"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#7d889b;" edge="1" parent="1" source="pay" target="hook"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#7d889b;" edge="1" parent="1" source="pg" target="backup"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#7d889b;" edge="1" parent="1" source="backup" target="store"><mxGeometry relative="1" as="geometry"/></mxCell>
