        <mxCell id="m3" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#1d8457;strokeWidth=2;" edge="1" parent="1" source="worker" target="n3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="530"/><mxPoint x="940" y="530"/></Array></mxGeometry></mxCell>

