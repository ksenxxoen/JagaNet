        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#7d889b;" edge="1" parent="1" source="worker" target="smtp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="260"/><mxPoint x="930" y="260"/><mxPoint x="930" y="370"/></Array></mxGeometry></mxCell>

        <!-- Node management (mTLS) -->
