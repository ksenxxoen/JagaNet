        <!-- HTTPS / control edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#7d889b;" edge="1" parent="1" source="android" target="cdn"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeColor=#7d889b;" edge="1" parent="1" source="ios" target="cdn"><mxGeometry relative="1" as="geometry"/></mxCell>
