<mxfile host="app.diagrams.net">
  <diagram id="jaganet-target" name="JagaNet">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Zones -->
        <mxCell id="cp" value="&lt;b&gt;Control plane (отдельный VPS)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5a6476&quot;&gt;аккаунты, тарифы, оплата; VPN-трафик сюда не идёт&lt;/font&gt;" style="html=1;rounded=1;arcSize=4;dashed=1;fillColor=#fbf0dc;strokeColor=#a8670f;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontColor=#a8670f;" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="860" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="dp" value="&lt;b&gt;VPN-ноды&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5a6476&quot;&gt;только пропускают трафик пользователей&lt;/font&gt;" style="html=1;rounded=1;arcSize=4;dashed=1;fillColor=#f2f4f7;strokeColor=#7d889b;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontColor=#5a6476;" vertex="1" parent="1">
          <mxGeometry x="40" y="570" width="1080" height="170" as="geometry"/>
        </mxCell>

        <!-- Clients -->
        <mxCell id="android" value="&lt;b&gt;Android&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5a6476&quot;&gt;приложение, туннель AmneziaWG&lt;/font&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#7d889b;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="160" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="ios" value="&lt;b&gt;iOS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5a6476&quot;&gt;приложение, Packet Tunnel&lt;/font&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#7d889b;" vertex="1" parent="1">
          <mxGeometry x="220" y="20" width="160" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="site" value="&lt;b&gt;Сайт&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5a6476&quot;&gt;покупка, ключи, рефералы&lt;/font&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#7d889b;" vertex="1" parent="1">
          <mxGeometry x="400" y="20" width="160" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="tg" value="&lt;b&gt;Telegram&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5a6476&quot;&gt;пользователи бота&lt;/font&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#7d889b;" vertex="1" parent="1">
          <mxGeometry x="580" y="20" width="160" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="third" value="&lt;b&gt;AmneziaVPN / WG&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5a6476&quot;&gt;чужие приложения по VPN-ключу&lt;/font&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#7d889b;" vertex="1" parent="1">
          <mxGeometry x="960" y="20" width="160" height="56" as="geometry"/>
        </mxCell>

        <!-- Entry -->
        <mxCell id="cdn" value="&lt;b&gt;CDN + резервные домены&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5a6476&quot;&gt;прячет IP сервера, переживает блокировки&lt;/font&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#e5f4ec;strokeColor=#1d8457;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="520" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="tgapi" value="&lt;b&gt;Telegram Bot API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5a6476&quot;&gt;сообщения бота&lt;/font&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#7d889b;" vertex="1" parent="1">
          <mxGeometry x="580" y="130" width="160" height="56" as="geometry"/>
        </mxCell>

        <!-- Control plane -->
        <mxCell id="api" value="&lt;b&gt;API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5a6476&quot;&gt;вход, заказы, ключи, админка&lt;/font&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#7d889b;" vertex="1" parent="1">
          <mxGeometry x="70" y="280" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="worker" value="&lt;b&gt;Worker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5a6476&quot;&gt;бот, учёт трафика, мониторинг, сверка пиров&lt;/font&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#e5f4ec;strokeColor=#1d8457;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="300" y="280" width="200" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="hook" value="&lt;b&gt;Вебхук оплаты&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5a6476&quot;&gt;оплата → Pro + VPN-ключ&lt;/font&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#e5f4ec;strokeColor=#1d8457;strokeWidth=2;" vertex="1" parent="1">
