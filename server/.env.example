# Production settings for the JagaNet server. `./gradlew :server:sim` needs none of these.
PORT=4000
DATABASE_URL=jdbc:postgresql://localhost:5432/jaganet
DATABASE_USER=jaganet
DATABASE_PASSWORD=
# 32+ random characters: openssl rand -base64 48
AUTH_SECRET=
PUBLIC_URL=https://api.example.com
# This email gets the owner dashboard.
OWNER_EMAIL=you@example.com
# Drivers to run, in preference order ("Automatic" on devices picks the first they support).
PROTOCOLS=amneziawg,wireguard
FREE_MONTHLY_GB=10
FREE_DEVICE_LIMIT=1
PRO_DEVICE_LIMIT=5
REFERRAL_REWARD_DAYS=30
CURRENCY=USD
# List prices in minor units, only for the owner's MRR figure. Store prices are authoritative.
PRICE_MONTHLY_MINOR=
PRICE_YEARLY_MINOR=
