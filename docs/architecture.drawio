        </mxCell>
        <mxCell id="pg" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5a6476&quot;&gt;источник истины: аккаунты, подписки, пиры&lt;/font&gt;" style="html=1;shape=cylinder3;boundedLbl=1;size=10;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#7d889b;" vertex="1" parent="1">
