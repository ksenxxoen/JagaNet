<mxfile host="app.diagrams.net">
  <diagram id="jaganet-target" name="JagaNet">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Zones -->
        <mxCell id="cp" value="Control plane (отдельный VPS)" style="rounded=1;arcSize=4;dashed=1;fillColor=#fbf0dc;strokeColor=#a8670f;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontColor=#a8670f;" vertex="1" parent="1">
