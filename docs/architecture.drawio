          <mxGeometry x="670" y="395" width="200" height="60" as="geometry"/>
        </mxCell>

        <!-- External -->
        <mxCell id="pay" value="&lt;b&gt;Платёжка&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5a6476&quot;&gt;принимает деньги&lt;/font&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#e5f4ec;strokeColor=#1d8457;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="960" y="278" width="160" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="smtp" value="&lt;b&gt;SMTP&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5a6476&quot;&gt;коды входа, алерты&lt;/font&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#7d889b;" vertex="1" parent="1">
          <mxGeometry x="960" y="343" width="160" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="store" value="&lt;b&gt;Хранилище&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5a6476&quot;&gt;бэкапы вне VPS&lt;/font&gt;" style="html=1;rounded=1;whiteSpace=wrap;fillColor=#e5f4ec;strokeColor=#1d8457;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="960" y="408" width="160" height="56" as="geometry"/>
        </mxCell>

        <!-- Nodes -->
        <mxCell id="n1" value="&lt;b&gt;FRA-1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5a6476&quot;&gt;awg0 + node-agent: пиры, счётчики, метрики&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7d889b;" vertex="1" parent="1">
          <mxGeometry x="70" y="620" width="300" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n2" value="&lt;b&gt;NL-1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5a6476&quot;&gt;запасная страна и провайдер&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e5f4ec;strokeColor=#1d8457;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="430" y="620" width="300" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;Нода N&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5a6476&quot;&gt;добавляется по мере роста&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#e5f4ec;strokeColor=#1d8457;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="790" y="620" width="300" height="90" as="geometry"/>
