{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Boop VPN",
  "version": "2.0.2",
  "identifier": "app.boopvpn.desktop",
  "build": { "frontendDist": "./dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Boop VPN", "width": 380, "height": 640, "minWidth": 360, "minHeight": 520, "center": true, "visible": false }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": { "webviewInstallMode": { "type": "skip" } }
  }
}
